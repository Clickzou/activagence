# Formulaire de contact — sans ces variables, la route /api/contact repond 503
# avec un message invitant a telephoner (jamais de faux « message envoye »).

RESEND_API_KEY=

# Expediteur technique : Resend n'accepte qu'une adresse sur un domaine verifie.
# Cette adresse n'est jamais affichee au visiteur ; elle sert uniquement a l'envoi.
CONTACT_FROM=site@activagencetoulouse.fr

# Destinataire reel des demandes : l'adresse de l'agence.
CONTACT_TO=activagence@free.fr
